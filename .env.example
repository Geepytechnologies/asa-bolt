ASA_BOLT_PORT=8787
ASA_BOLT_OWNER_PASSWORD=change-me-locally
ASA_BOLT_OWNER_EMAIL=owner@example.test
ASA_BOLT_OWNER_NOTIFICATION_EMAIL=owner@example.test
ASA_BOLT_DATABASE_PATH=./data/asa-bolt.sqlite
ASA_BOLT_PUBLIC_APP_URL=http://localhost:5173
# Optional private local email previews; never use a public/static directory.
# Disabled in production. Leave blank when using Resend.
ASA_BOLT_EMAIL_OUTBOX_DIR=
# Resend is selected. Configure later; missing credentials show a clear delivery failure.
ASA_BOLT_EMAIL_PROVIDER=resend
RESEND_API_KEY=
ASA_BOLT_EMAIL_FROM=
ASA_BOLT_EMAIL_REPLY_TO=
# Signed event endpoint: PUBLIC_APP_URL/api/webhooks/resend
RESEND_WEBHOOK_SECRET=
# Optional provider webhooks. Use a provider/worker that translates these events
# into email and WhatsApp Business Platform messages in production.
ASA_BOLT_EMAIL_WEBHOOK_URL=
ASA_BOLT_EMAIL_WEBHOOK_TOKEN=
# Set true only after the adapter is verified to deduplicate Idempotency-Key
# atomically and retain that key across retries. Needed to retry uncertain sends.
ASA_BOLT_EMAIL_WEBHOOK_IDEMPOTENT=false
# The adapter must retain keys for at least this many minutes. Uncertain sends
# older than this window cannot be retried. Values: 1–10080; default 60.
ASA_BOLT_EMAIL_WEBHOOK_IDEMPOTENCY_MINUTES=60
ASA_BOLT_WHATSAPP_WEBHOOK_URL=
ASA_BOLT_WHATSAPP_WEBHOOK_TOKEN=
ASA_BOLT_WHATSAPP_WEBHOOK_IDEMPOTENT=false
ASA_BOLT_WHATSAPP_WEBHOOK_IDEMPOTENCY_MINUTES=60
# Production uses persistent storage and automatic verified snapshots.
ASA_BOLT_HOST=127.0.0.1
ASA_BOLT_STATIC_DIR=
ASA_BOLT_TRUST_PROXY=0
ASA_BOLT_BACKUP_DIR=
ASA_BOLT_BACKUP_HOURS=6
# Optional Google Calendar. Leave blank until ready; the admin portal shows Not configured.
# Register /api/calendar/google/callback on ASA_BOLT_PUBLIC_APP_URL as the OAuth redirect URI.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Generate with: openssl rand -hex 32. Keep this key stable to unlock encrypted calendar tokens.
ASA_BOLT_CALENDAR_TOKEN_KEY=
