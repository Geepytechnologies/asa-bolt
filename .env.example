ASA_BOLT_PORT=8787
ASA_BOLT_OWNER_PASSWORD=change-me-locally
ASA_BOLT_OWNER_EMAIL=owner@example.test
ASA_BOLT_OWNER_WHATSAPP=2348000000000
ASA_BOLT_OWNER_NOTIFICATION_EMAIL=owner@example.test
ASA_BOLT_DATABASE_PATH=./data/asa-bolt.sqlite
# Set to "console" for safe local adapters. Production adapters are intentionally not bundled.
ASA_BOLT_EMAIL_PROVIDER=console
ASA_BOLT_WHATSAPP_PROVIDER=console
# Optional provider webhooks. Use a provider/worker that translates these events
# into email and WhatsApp Business Platform messages in production.
ASA_BOLT_EMAIL_WEBHOOK_URL=
ASA_BOLT_EMAIL_WEBHOOK_TOKEN=
ASA_BOLT_WHATSAPP_WEBHOOK_URL=
ASA_BOLT_WHATSAPP_WEBHOOK_TOKEN=
