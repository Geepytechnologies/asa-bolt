# Copy to .env.production, protect with chmod 600, and supply actual values before release.
NODE_ENV=production
ASA_BOLT_DOMAIN=rides.example.com
ASA_BOLT_PUBLIC_APP_URL=https://rides.example.com
# Generate a unique password, for example: openssl rand -hex 24
ASA_BOLT_OWNER_PASSWORD=
ASA_BOLT_OWNER_NOTIFICATION_EMAIL=
ASA_BOLT_EMAIL_PROVIDER=resend
RESEND_API_KEY=
ASA_BOLT_EMAIL_FROM=
ASA_BOLT_EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=
ASA_BOLT_BACKUP_HOURS=6
# Optional WhatsApp stays disabled in admin until configured and manually verified.
ASA_BOLT_WHATSAPP_WEBHOOK_URL=
ASA_BOLT_WHATSAPP_WEBHOOK_TOKEN=
ASA_BOLT_WHATSAPP_WEBHOOK_IDEMPOTENT=false
ASA_BOLT_WHATSAPP_WEBHOOK_IDEMPOTENCY_MINUTES=60
# Optional Google Calendar; blank values leave calendar linking disabled until configured.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Generate with openssl rand -hex 32; retain securely with your recovery secrets.
ASA_BOLT_CALENDAR_TOKEN_KEY=
